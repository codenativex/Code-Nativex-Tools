# Code Nativex Tools -> Live Website Audit Worker
# Local worker default from the Live Audit Agent project:
AUDIT_WORKER_BASE_URL=http://127.0.0.1:8088

# MUST be identical to AUDIT_API_TOKEN in the audit worker's .env
# Use a random value of at least 32 characters.
AUDIT_WORKER_TOKEN=replace_with_the_same_long_token_used_by_the_worker
