# Public base URL used for canonical URLs, sitemap and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: absolute URL of the main Code Nativex marketing website.
NEXT_PUBLIC_MAIN_SITE_URL=https://codenativex.com

# Server-only. Where contact form submissions are POSTed as JSON.
# Works with any inbox, automation or chat integration that accepts a webhook.
# While this is unset, /contact shows an email address instead of a form —
# the platform never accepts a message it cannot deliver.
CONTACT_WEBHOOK_URL=
